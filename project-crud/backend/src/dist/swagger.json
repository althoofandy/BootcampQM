{
    "openapi": "3.0.0",
    "info": {
        "title": "Cart API",
        "version": "1.0.0"
    },
    "paths": {
        "/users": {
            "get": {
                "summary": "Get all users",
                "responses": {
                    "200": {
                        "description": "List of users"
                    }
                }
            }
        },
        "/products": {
            "get": {
                "summary": "Get all products",
                "responses": {
                    "200": {
                        "description": "List of products"
                    }
                }
            },
            "post": {
                "summary": "Add new product",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "name": { "type": "string" },
                                    "price": { "type": "integer" },
                                    "stock": { "type": "integer" },
                                    "categoryId": { "type": "string" },
                                    "description": { "type": "string" },
                                    "image": { "type": "string" }
                                },
                                "required": [
                                    "name",
                                    "price",
                                    "stock",
                                    "categoryId",
                                    "description",
                                    "image"
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Product created"
                    }
                }
            }
        },
        "/user/cart/{userId}": {
            "get": {
                "summary": "Get specific user's cart with total price",
                "parameters": [
                    {
                        "name": "userId",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User cart with total price"
                    }
                }
            }
        },
        "/user/cart": {
            "post": {
                "summary": "Add product to user's cart",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "userId": { "type": "string" },
                                    "productId": { "type": "string" },
                                    "quantity": { "type": "integer" }
                                },
                                "required": ["userId", "productId", "quantity"]
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Cart item added"
                    }
                }
            }
        },
        "/user/cart/{cartId}": {
            "delete": {
                "summary": "Delete product from cart",
                "parameters": [
                    {
                        "name": "cartId",
                        "in": "path",
                        "required": true,
                        "schema": { "type": "string" }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Cart item deleted"
                    }
                }
            }
        }
    }
}
